{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/hero-frames/(.*)",
      "destination": "/public/hero-frames/$1"
    },
    {
      "source": "/turntable-frames/(.*)",
      "destination": "/public/turntable-frames/$1"
    },
    {
      "source": "/fullarch-frames/(.*)",
      "destination": "/public/fullarch-frames/$1"
    },
    {
      "source": "/planning-frames/(.*)",
      "destination": "/public/planning-frames/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "/public/images/$1"
    }
  ]
}
